{
    "timeSlice": "5m",
    "rules": [
        {
            "name": "FATAL_EVENT",
            "severity": ["FATAL"],
            "threshold": 1,
            "keywords": [],
            "incidentSeverity": "HIGH"
        },
        {
            "name": "ERROR_SPIKE",
            "severity": ["ERROR"],
            "threshold": 5,
            "keywords": [],
            "incidentSeverity": "MEDIUM"
        },
        {
            "name": "WARNING_SPIKE",
            "severity": ["WARN"],
            "threshold": 10,
            "keywords": [],
            "incidentSeverity": "LOW"
        },
        {
           "name": "DATABASE_CONNECTION_FAILURE",
           "severity": ["ERROR", "FATAL"],
           "threshold": 1,
           "keywords": ["database", "connection"],
           "incidentSeverity": "HIGH"
        },
        {
            "name": "SQL_ERROR",
            "severity": ["ERROR", "FATAL"],
            "threshold": 1,
            "keywords": ["sql", "syntax", "query"],
            "incidentSeverity": "MEDIUM"
        },
        {
            "name": "PAYMENT_GATEWAY_FAILURE",
            "severity": ["ERROR", "FATAL"],
            "threshold": 1,
            "keywords": ["payment", "gateway", "transaction"],
            "incidentSeverity": "HIGH"
        },
        {
            "name": "APPLICATION_EXCEPTION",
            "severity": ["ERROR", "FATAL"],
            "threshold": 1,
            "keywords": ["exception", "panic", "nullpointer"],
            "incidentSeverity": "HIGH"
        },
        {
            "name": "HIGH_MEMORY_USAGE",
            "severity": ["WARN", "ERROR", "FATAL"],
            "threshold": 1,
            "keywords": ["memory", "heap", "oom"],
            "incidentSeverity": "MEDIUM"
        },
        {
            "name": "RATE_LIMIT_WARNING",
            "severity": ["WARN", "ERROR", "FATAL"],
            "threshold": 1,
            "keywords": ["rate", "limit"],
            "incidentSeverity": "LOW"
        },
        {
            "name": "DEPRECATED_API_USAGE",
            "severity": ["WARN", "ERROR", "FATAL"],
            "threshold": 1,
            "keywords": ["deprecated", "legacy"],
            "incidentSeverity": "LOW"
        }
    ]
}